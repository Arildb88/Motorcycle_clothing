DATABASE_URL="file:./dev.db"
PORT=3000
JWT_SECRET="dev-change-me-motorcycle-clothing"
JWT_EXPIRES_IN="7d"
MET_USER_AGENT="MotorcycleClothingApp/0.1 (dev; contact@example.com)"
WEATHER_PROVIDER="mock"
NODE_ENV="development"

# Deep link used by mobile OAuth redirects (IdP + Strava)
OAUTH_REDIRECT_URI="ridewear://oauth/callback"

# 32-byte hex (64 chars) OR any passphrase (scrypt-derived). Required for Strava token storage.
TOKEN_ENCRYPTION_KEY="dev-only-change-me-ridewear-token-key"

# Facebook Login (identity provider) — leave empty to disable in UI
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Microsoft Entra / identity platform (identity provider)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Strava (connected service — not a login method)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI="ridewear://oauth/callback"

# Non-production only: allow POST /auth/oauth with demo: tokens
ALLOW_DEMO_OAUTH=true
