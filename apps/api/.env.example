# Local Docker Postgres 16. Not a Supabase URL. Hosted credentials stay outside git.
# DATABASE_URL is the Prisma Client runtime URL (local unpooled port 5432).
# DIRECT_URL is the Prisma Migrate URL. Locally it is the same database.
# Hosted roles, session pooler versus direct host, and the empty-public
# preflight are documented in docs/operations/SUPABASE_FIRST_DEPLOY.md.
# Never commit a hosted URL, project ref, or password. Never use port 6543.
DATABASE_URL="postgresql://motorcycle:motorcycle@localhost:5432/motorcycle"
DIRECT_URL="postgresql://motorcycle:motorcycle@localhost:5432/motorcycle"
PORT=3000
JWT_SECRET="dev-change-me-motorcycle-clothing"
JWT_EXPIRES_IN="7d"
# Identifying MET contact. Replace contact@example.com before expecting forecasts.
# An existing local .env that still says WEATHER_PROVIDER=mock must be changed
# to met. Do not commit the real contact or any provider key.
MET_USER_AGENT="MotorcycleClothingApp/0.1 (dev; contact@example.com)"
WEATHER_PROVIDER="met"
NODE_ENV="development"

# Deep link used by mobile OAuth redirects (IdP + Strava)
OAUTH_REDIRECT_URI="ridewear://oauth/callback"

# 32-byte hex (64 chars) OR any passphrase (scrypt-derived). Required for Strava token storage.
TOKEN_ENCRYPTION_KEY="dev-only-change-me-ridewear-token-key"

# Facebook Login (identity provider) — leave empty to disable in UI
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Microsoft Entra / identity platform (identity provider)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Strava (connected service — not a login method)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI="ridewear://oauth/callback"

# Non-production only: POST /auth/oauth accepts demo: tokens when NODE_ENV
# is not production. Setting this true cannot enable those tokens in production.
ALLOW_DEMO_OAUTH=true

# Browser origins allowed to call the API with credentials, comma-separated.
# Native Flutter clients omit Origin. Outside production, localhost and
# 127.0.0.1 are allowed as well. Do not use a reflected wildcard.
# CORS_ORIGINS="https://ride.example"

# Auth endpoints allow 20 attempts per 15 minutes per direct client address.
# Set to off only for a local debug session. The limit is in-memory per process.
# AUTH_RATE_LIMIT=off

# Optional SMTP for password-reset emails. When unset and NODE_ENV is not
# production, POST /auth/forgot-password may include `devResetToken` so local
# testing works without a mail server. Tokens are never returned in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RideWear <noreply@example.com>"
# Deep link / web URL template used in reset emails (token appended as ?token=)
# PASSWORD_RESET_PUBLIC_URL="ridewear://reset-password"

# Road routing and place search (OpenRouteService via HeiGIT). The key stays
# on the server and must never be shipped in the Flutter app.
# Directions: https://api.heigit.org/openrouteservice/
# Geocoding:  https://api.heigit.org/pelias/v1
# Do not use the deprecated api.openrouteservice.org host.
ROUTING_PROVIDER=ors
ORS_API_KEY=

# Ground elevation for route weather samples. Kartverket open data (CC BY 4.0).
# Default is kartverket. Set to off to skip elevation; recommendations still run
# on lat/lon only. No API key. Credit "© Kartverket" when heights are shown.
ELEVATION_PROVIDER=kartverket
# ELEVATION_BASE_URL=https://ws.geonorge.no/hoydedata/v1
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# ORS_GEOCODE_BASE_URL=https://api.heigit.org/pelias/v1
